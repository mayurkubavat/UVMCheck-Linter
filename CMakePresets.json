{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (Safe Memory, Ninja)",
      "description": "Release configuration with Ninja and 4-job concurrency throttle",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "fast-dev",
      "displayName": "Fast Dev (Unity Build + Ninja)",
      "description": "Fast development configuration with Unity Build and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "UVMCHECK_ENABLE_UNITY_BUILD": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "model",
      "displayName": "Release + shared model library (Rust/Python)",
      "description": "Builds libuvmcheck_model.so with its C ABI for rust/ and other tools; position independent, no mimalloc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-model",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UVMCHECK_BUILD_MODEL_LIB": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "fast-dev",
      "configurePreset": "fast-dev"
    },
    {
      "name": "model",
      "configurePreset": "model"
    }
  ]
}
