{
  "name": "uvmcheck-vscode",
  "displayName": "UVMCheck SystemVerilog & UVM Linter",
  "description": "SystemVerilog and UVM linter and code browser: live diagnostics, quick fixes, go to definition, outline, completion and UVM snippets",
  "version": "0.2.0",
  "publisher": "mayurkubavat",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "systemverilog",
    "uvm",
    "verilog",
    "linter",
    "slang",
    "verification"
  ],
  "activationEvents": [
    "onLanguage:systemverilog",
    "onLanguage:verilog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "UVMCheck Configuration",
      "properties": {
        "uvmcheck.enable": {
          "type": "boolean",
          "default": true,
          "description": "Lint as you type: diagnostics and quick fixes from the UVMCheck language server (`dv-lsp`), under the project's `.uvmcheck` config, waivers and baseline."
        },
        "uvmcheck.executablePath": {
          "type": "string",
          "default": "",
          "description": "Only to lint with the Slang reference engine instead: the path of a `uvmcheck-slang` binary, run with `--lsp` next to `dv-lsp`. Leave empty for the native engine."
        },
        "uvmcheck.navigation.enable": {
          "type": "boolean",
          "default": true,
          "description": "Code browsing from the language server: outline, go to definition, references, hover and completion."
        },
        "uvmcheck.navigation.serverPath": {
          "type": "string",
          "default": "dv-lsp",
          "description": "Path to the `dv-lsp` executable (lint and code browsing). Left as `dv-lsp`, the binary bundled with the extension is used, else the one on PATH."
        },
        "uvmcheck.navigation.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra source trees to index for navigation, such as a UVM or VIP install ($VARS and ~ are expanded)."
        },
        "uvmcheck.navigation.useUvmHome": {
          "type": "boolean",
          "default": true,
          "description": "Also index $UVM_HOME/src when UVM_HOME is set."
        },
        "uvmcheck.navigation.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directory names (or path endings) to skip when indexing the workspace, e.g. `sim_build` or `vendor/old_vip`."
        },
        "uvmcheck.trace.server": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Traces the communication between VS Code / Cursor and the UVMCheck language server daemon."
        }
      }
    },
    "commands": [
      {
        "command": "uvmcheck.restartServer",
        "title": "UVMCheck: Restart Language Servers"
      }
    ],
    "languages": [
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog",
          "sv"
        ],
        "extensions": [
          ".sv",
          ".svh",
          ".svi",
          ".svp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/uvmcheck.svg",
          "dark": "./images/uvmcheck.svg"
        }
      },
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh",
          ".vlib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.verilog.uvmcheck",
        "path": "./syntaxes/verilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "systemverilog",
        "path": "./snippets/systemverilog.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package",
    "watch": "tsc -watch -p ./",
    "publish:openvsx": "ovsx publish",
    "bundle:local": "sh scripts/bundle-local.sh"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.82.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^0.10.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "images/uvmcheck.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/mayurkubavat/UVMCheck-Linter"
  },
  "galleryBanner": {
    "color": "#EAF2FF",
    "theme": "light"
  }
}
